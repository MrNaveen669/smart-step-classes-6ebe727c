# Public Supabase values. The VITE_ variants are compiled into the browser
# bundle, so they must be available during the Render build.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-only secrets. Never prefix these with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
OPENROUTER_API_KEY=your_openrouter_key

# Optional local-development override for server-side OpenRouter attribution.
# Render supplies RENDER_EXTERNAL_URL automatically in production.
APP_URL=https://your-service.onrender.com
